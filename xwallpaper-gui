#!/usr/bin/env python3
"""Launch XWallpaper GUI from a source checkout or user installation."""

import os
from pathlib import Path
import sys


try:
    from xwallpaper_gui import main
except ModuleNotFoundError:
    data_home = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share"))
    sys.path.insert(0, str(data_home / "xwallpaper-gui"))
    from xwallpaper_gui import main


if __name__ == "__main__":
    raise SystemExit(main())
